{
  "name": "@umituz/web-hono",
  "version": "5.4.1",
  "description": "API backend platform for Cloudflare Workers + Postgres: createApi skeleton + error envelope layer, full-CRUD resource factory (opt-in create/remove, list params), schema→client type bridge (ClientRow), apiFetch/apiWrite client, reactive fetch-backed store (+React hooks), doc-sync diff/snapshot/push machine (snapshotDocs/diffOps/pushOps), weak-compare If-None-Match matcher (matchesEtag), cookie channels + request scope/ETag/R2-stream server helpers, TTL resource cache, and an RFC-4180 CSV codec (BOM/delimiter tolerance, row-numbered parse, formula-injection-safe stringify). Database transport lives in @umituz/web-database",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./validator": "./src/validator.ts",
    "./client": "./src/client.ts",
    "./dates": "./src/dates.ts",
    "./csv": "./src/csv.ts",
    "./store": "./src/store.ts",
    "./store/react": "./src/store-react.ts",
    "./sync": "./src/sync.ts",
    "./lib": "./src/lib.ts",
    "./mail": "./src/mail.ts",
    "./etag": "./src/etag.ts",
    "./cookies": "./src/cookies.ts",
    "./http": "./src/http.ts",
    "./r2": "./src/r2.ts",
    "./resource": "./src/resource.ts",
    "./resource/react": "./src/resource-react.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "keywords": [
    "hono",
    "hono-api",
    "cloudflare-workers",
    "workers",
    "postgres",
    "drizzle",
    "drizzle-orm",
    "crud",
    "crud-factory",
    "rest-api",
    "spa-fallback",
    "zod",
    "validation",
    "api-client",
    "store",
    "reactive-store",
    "cache",
    "serverless",
    "typescript",
    "edge"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-hono.git"
  },
  "peerDependencies": {
    "@umituz/web-database": ">=1.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^9.32.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "~22.13.10",
    "@types/react": "^19.1.0",
    "@umituz/web-database": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.32.0",
    "hono": "^4.13.13",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "3.2.4",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}

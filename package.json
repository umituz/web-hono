{
  "name": "@umituz/web-hono",
  "version": "1.12.0",
  "description": "API backend platform for Cloudflare Workers + Neon Postgres: createApi skeleton + error envelope layer, full-CRUD resource factory (opt-in create/remove, list params), schema→client type bridge (ClientRow), apiFetch/apiWrite client, reactive fetch-backed store (+React hooks), better-auth server integration (tables/getter/mount/session helpers), weak-compare If-None-Match matcher (matchesEtag), and db lifecycle scripts (reset / snapshot / seed)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./validator": "./src/validator.ts",
    "./client": "./src/client.ts",
    "./dates": "./src/dates.ts",
    "./store": "./src/store.ts",
    "./store/react": "./src/store-react.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./auth": "./src/auth.ts",
    "./etag": "./src/etag.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "keywords": [
    "hono",
    "hono-api",
    "cloudflare-workers",
    "workers",
    "neon",
    "postgres",
    "drizzle",
    "drizzle-orm",
    "crud",
    "crud-factory",
    "rest-api",
    "spa-fallback",
    "zod",
    "validation",
    "api-client",
    "store",
    "reactive-store",
    "cache",
    "seed",
    "snapshot",
    "database-lifecycle",
    "serverless",
    "typescript",
    "edge"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-hono.git"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^9.32.0",
    "@neondatabase/serverless": "^1.2.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "~22.13.10",
    "@types/react": "^19.1.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.32.0",
    "hono": "^4.13.13",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "3.2.4",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
